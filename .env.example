PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
AI_MODEL=gemma-4-31b-it
# PORT=8790
# Optional alternatives if you are not using Gemma via a Google AI key:
# OPENAI_API_KEY=
# KENARI_API_KEY=

# Hosted mode (DESK_HOSTED=1) does not read this file at all: visitors supply
# their own sandbox keys in the page, and platform settings come from real
# environment variables. For reference, the hosted knobs are:
# DESK_HOSTED=1            serve the connect gate and per-visitor sessions
# DESK_TRUST_PROXY=1       believe x-forwarded-proto / x-forwarded-for behind your TLS proxy
#                          (only if that proxy OVERWRITES both headers and the app port
#                          is unreachable except through it -- see README)
# DESK_TRUSTED_PROXIES=    comma-separated allowlist of proxy addresses or IPv4 CIDR that
#                          DESK_TRUST_PROXY may believe; defaults to loopback. List only
#                          the proxy's own address. Peers outside it fail closed.
# DESK_INSECURE_LOCAL=1    localhost only: accept http and drop the Secure cookie flag
# PORT=                    the platform's port; DESK_PORT overrides it
